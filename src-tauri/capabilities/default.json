{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what the main window needs. File access comes from the native dialogs at runtime.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:menu:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file"
  ]
}
