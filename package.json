{
  "name": "smorsy-pdf-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check": "tsc --noEmit && tsc --noEmit -p tests/native && eslint . && prettier --check . && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run --reporter=dot",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --quiet",
    "test:e2e": "playwright test --reporter=line",
    "test:native": "wdio run tests/native/wdio.conf.ts",
    "test:roundtrip": "vitest run --config vitest.roundtrip.config.ts --reporter=dot",
    "fixtures": "node scripts/build-fixtures.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.2.1",
    "@wdio/cli": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "9.33.1",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "eslint": "10.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "webdriverio": "9.33.1"
  },
  "allowScripts": {
    "lefthook@2.2.2": true,
    "esbuild": false,
    "edgedriver": false,
    "geckodriver": false
  }
}
